{
  "name": "mandoca-studio",
  "version": "1.0.0",
  "description": "Tema de WordPress de Mandoca Studio, estudio independiente de videojuegos. Editable con Elementor y animado con GSAP.",
  "private": true,
  "scripts": {
    "format": "prettier --write \"**/*.{html,css,js,md}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,md}\""
  },
  "keywords": ["videojuegos", "estudio", "wordpress", "elementor", "gsap"],
  "license": "MIT",
  "dependencies": {
    "gsap": "3.13.0"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
